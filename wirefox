#!/usr/bin/env python3
"""
Wirefox — rootless WireGuard GUI (GTK4) for Linux.

Uses NetworkManager as backend so no root rights are needed.
Configs are stored user-editable in ~/.config/wirefox/.

Dependencies:
    Debian/Ubuntu: sudo apt install python3-gi gir1.2-gtk-4.0 gir1.2-adw-1 network-manager
    Fedora:        sudo dnf install python3-gobject gtk4 libadwaita NetworkManager

Usage:
    wirefox [--version]

License: GPL-3.0-or-later
"""

import gettext
import os
import re
import shutil
import subprocess
import sys
import threading
import zipfile

VERSION    = "0.2.2"

# --version must work without GTK (scripts, packaging checks)
if __name__ == "__main__" and "--version" in sys.argv:
    print(f"wirefox {VERSION}")
    sys.exit(0)

try:
    import gi
    gi.require_version("Gtk", "4.0")
    gi.require_version("Gdk", "4.0")
    gi.require_version("Adw", "1")
    from gi.repository import Gtk, Gdk, Adw, GLib, Gio
except (ImportError, ValueError) as exc:
    # e.g. a missing typelib: show what to install instead of a traceback
    sys.exit(f"Wirefox cannot load GTK 4 / libadwaita: {exc}\n"
             "  Debian/Ubuntu: sudo apt install python3-gi gir1.2-gtk-4.0 "
             "gir1.2-adw-1\n"
             "  Fedora:        sudo dnf install python3-gobject gtk4 "
             "libadwaita gobject-introspection")

APP_ID     = "nl.voxfox.Wirefox"
CONF_DIR   = os.path.expanduser("~/.config/wirefox")
LOCALE_DIR = "/usr/share/locale"
REFRESH_S  = 5   # UI refresh (kernel reads only, no NetworkManager)

# IPv4 per tunnel, filled while the tunnel is up (avoids running `ip` every tick)
_details_cache: dict = {}

# ---------------------------------------------------------------- i18n

gettext.bindtextdomain("wirefox", LOCALE_DIR)
gettext.textdomain("wirefox")
_ = gettext.gettext

TEMPLATE = """\
[Interface]
PrivateKey = <private key>
Address = 10.0.0.2/32
DNS = 1.1.1.1

[Peer]
PublicKey = <server public key>
Endpoint = vpn.example.com:51820
AllowedIPs = 0.0.0.0/0, ::/0
PersistentKeepalive = 25
"""

# ---------------------------------------------------------------- nmcli

def _run(cmd, timeout=15):
    try:
        p = subprocess.run(cmd, capture_output=True, text=True, timeout=timeout)
        return p.returncode == 0, (p.stdout + p.stderr).strip()
    except Exception as exc:
        return False, str(exc)


def nmcli(*args, timeout=15):
    return _run(["nmcli", "--escape", "no"] + list(args), timeout=timeout)


def nm_wireguard_connections():
    """{name: active_bool} — only wireguard connections."""
    ok, out = nmcli("-t", "-f", "NAME,TYPE,ACTIVE", "connection", "show")
    conns = {}
    if ok:
        for line in out.splitlines():
            parts = line.rsplit(":", 2)
            if len(parts) == 3 and parts[1] == "wireguard":
                conns[parts[0]] = (parts[2] == "yes")
    return conns


def disable_all_autoconnect():
    """Clear autoconnect on every WireGuard connection.

    NetworkManager gives every imported connection autoconnect=yes, which
    also activates the tunnel at boot. Tunnels are manual-only, so clear it
    everywhere (also fixes connections set up by older Wirefox versions).
    """
    for name in nm_wireguard_connections():
        nmcli("connection", "modify", name, "connection.autoconnect", "no")


def nm_import(name, keep_up=False):
    """Import ~/.config/wirefox/<name>.conf into NetworkManager.

    `nmcli connection import` creates the profile with autoconnect=yes and
    usually activates it straight away. Switch autoconnect off immediately
    and take the tunnel down again unless it is supposed to be up.
    Returns (ok, output).
    """
    ok, out = nmcli("connection", "import", "type", "wireguard",
                    "file", conf_path(name))
    if not ok:
        return ok, out
    nmcli("connection", "modify", name, "connection.autoconnect", "no")
    if keep_up:
        nmcli("connection", "up", name)
    elif iface_is_up(name):
        nmcli("connection", "down", name)
    return ok, out


def nm_iface(name):
    """Kernel interface name of a NetworkManager connection.

    Tunnels imported by Wirefox use the connection name as interface name,
    but profiles created elsewhere (e.g. GNOME Settings) can differ.
    Only called on rebuild, never from the periodic refresh.
    """
    ok, out = nmcli("-g", "connection.interface-name", "connection",
                    "show", name, timeout=5)
    out = out.strip() if ok else ""
    return out or name


def iface_is_up(iface):
    """True when the kernel has this interface — costs nothing, no D-Bus."""
    return os.path.isdir(f"/sys/class/net/{iface}")


def iface_ipv4(iface):
    """IPv4 address of an interface via netlink (does not involve NM)."""
    ok, out = _run(["ip", "-4", "-o", "addr", "show", "dev", iface], timeout=5)
    if not ok:
        return ""
    for line in out.splitlines():
        parts = line.split()
        if "inet" in parts:
            i = parts.index("inet")
            if i + 1 < len(parts):
                return parts[i + 1]
    return ""


# ---------------------------------------------------------------- helpers

def ensure_conf_dir():
    """Create the config dir, readable only by the user (configs hold keys)."""
    os.makedirs(CONF_DIR, mode=0o700, exist_ok=True)
    try:
        os.chmod(CONF_DIR, 0o700)
    except OSError:
        pass


def write_private(path, text):
    """Write a file that is mode 0600 from the very first byte."""
    fd = os.open(path, os.O_WRONLY | os.O_CREAT | os.O_TRUNC, 0o600)
    with os.fdopen(fd, "w", encoding="utf-8") as f:
        f.write(text)
    os.chmod(path, 0o600)   # also tighten files that already existed


def local_configs():
    ensure_conf_dir()
    return sorted(f[:-5] for f in os.listdir(CONF_DIR) if f.endswith(".conf"))


def conf_path(name):
    return os.path.join(CONF_DIR, name + ".conf")


def valid_name(name):
    """Valid Linux interface name: max 15 chars, no '.' or '..'."""
    if name in (".", ".."):
        return False
    return bool(re.fullmatch(r"[a-zA-Z0-9_=+.\-]{1,15}", name))


def human_bytes(n):
    for unit in ("B", "KiB", "MiB", "GiB", "TiB"):
        if n < 1024 or unit == "TiB":
            return f"{int(n)} B" if unit == "B" else f"{n:.1f} {unit}"
        n /= 1024


def _read(path):
    with open(path, encoding="utf-8") as f:
        return f.read()


def iface_traffic(iface):
    try:
        base = f"/sys/class/net/{iface}/statistics"
        return int(_read(f"{base}/rx_bytes")), int(_read(f"{base}/tx_bytes"))
    except (OSError, ValueError):
        return None


def has_dns_leak_risk(name):
    path = conf_path(name)
    if not os.path.exists(path):
        return False
    try:
        text = _read(path)
    except (OSError, UnicodeDecodeError):
        return False
    catches_all = re.search(r"AllowedIPs\s*=.*0\.0\.0\.0/0", text)
    has_dns     = re.search(r"^\s*DNS\s*=", text, re.MULTILINE)
    return bool(catches_all and not has_dns)


# ---------------------------------------------------------------- editor

class EditorWindow(Adw.Window):
    def __init__(self, parent, name, on_saved):
        super().__init__(transient_for=parent, modal=True,
                         default_width=620, default_height=520,
                         title=f"{name}.conf")
        self.name     = name
        self.on_saved = on_saved

        view     = Adw.ToolbarView()
        header   = Adw.HeaderBar()
        save_btn = Gtk.Button(label=_("Save"))
        save_btn.add_css_class("suggested-action")
        save_btn.connect("clicked", self.save)
        header.pack_end(save_btn)
        view.add_top_bar(header)

        self.buffer = Gtk.TextBuffer()
        try:
            self.buffer.set_text(_read(conf_path(name)))
        except (OSError, UnicodeDecodeError):
            self.buffer.set_text(TEMPLATE)

        tv = Gtk.TextView(buffer=self.buffer, monospace=True,
                          top_margin=12, bottom_margin=12,
                          left_margin=12, right_margin=12,
                          wrap_mode=Gtk.WrapMode.NONE)
        view.set_content(Gtk.ScrolledWindow(child=tv, vexpand=True))
        self.set_content(view)

        ctrl = Gtk.EventControllerKey()
        ctrl.connect("key-pressed", self._on_key)
        self.add_controller(ctrl)

    def _on_key(self, _ctrl, keyval, _code, state):
        # Ctrl+S only (the default mod mask also contains Shift and Alt)
        if keyval in (Gdk.KEY_s, Gdk.KEY_S) and (
                state & Gdk.ModifierType.CONTROL_MASK):
            self.save(None)
            return True
        return False

    def save(self, _btn):
        s, e = self.buffer.get_bounds()
        text = self.buffer.get_text(s, e, True)
        try:
            ensure_conf_dir()
            write_private(conf_path(self.name), text)
        except OSError as exc:
            d = Adw.AlertDialog(heading=_("Save failed"), body=str(exc))
            d.add_response("ok", "OK")
            d.present(self)
            return
        self.on_saved(self.name)
        self.close()


# ---------------------------------------------------------------- main window

class MainWindow(Adw.ApplicationWindow):
    def __init__(self, app):
        super().__init__(application=app, title="Wirefox",
                         default_width=580, default_height=460)
        self.rows = {}      # name -> (row, toggle_button)
        self.ifaces = {}    # name -> kernel interface name
        self.nm_names = set()   # tunnels NetworkManager knows about
        self.toast_overlay = Adw.ToastOverlay()

        view   = Adw.ToolbarView()
        header = Adw.HeaderBar()

        btn_new = Gtk.Button(icon_name="document-new-symbolic",
                             tooltip_text=_("New tunnel"))
        btn_new.connect("clicked", self.new_tunnel)
        header.pack_start(btn_new)

        btn_imp = Gtk.Button(icon_name="document-open-symbolic",
                             tooltip_text=_("Import .conf"))
        btn_imp.connect("clicked", self.import_conf)
        header.pack_start(btn_imp)

        btn_zip = Gtk.Button(icon_name="package-x-generic-symbolic",
                             tooltip_text=_("Import .zip bundle"))
        btn_zip.connect("clicked", self.import_zip)
        header.pack_start(btn_zip)

        view.add_top_bar(header)

        self.listbox = Gtk.ListBox(selection_mode=Gtk.SelectionMode.NONE)
        self.listbox.add_css_class("boxed-list")

        clamp = Adw.Clamp(child=self.listbox, maximum_size=640,
                          margin_top=18, margin_bottom=18,
                          margin_start=12, margin_end=12)

        self.status_page = Adw.StatusPage(
            title=_("No tunnels"),
            # translate the template first, fill in the path afterwards
            description=_("Import a .conf file or create a new tunnel.\n"
                          "Configs live in {CONF_DIR}").format(
                              CONF_DIR=CONF_DIR),
            icon_name="network-vpn-symbolic",
        )

        self.stack = Gtk.Stack()
        self.stack.add_named(
            Gtk.ScrolledWindow(child=clamp, vexpand=True), "list")
        self.stack.add_named(self.status_page, "empty")

        self.toast_overlay.set_child(self.stack)
        view.set_content(self.toast_overlay)
        self.set_content(view)

        self.rebuild()
        threading.Thread(target=disable_all_autoconnect, daemon=True).start()
        self._timer_id = GLib.timeout_add_seconds(REFRESH_S, self._tick)
        self.connect("close-request", self._on_close)

    def _all_tunnels(self):
        nm = nm_wireguard_connections()
        return sorted(set(local_configs()) | set(nm)), nm

    def rebuild(self):
        while (child := self.listbox.get_first_child()):
            self.listbox.remove(child)
        self.rows = {}
        self.ifaces = {}

        names, nm = self._all_tunnels()
        self.stack.set_visible_child_name("list" if names else "empty")

        for name in names:
            self.ifaces[name] = nm_iface(name) if name in nm else name

            row = Adw.ActionRow(title=name)
            row.set_subtitle("…")

            if has_dns_leak_risk(name):
                warn = Gtk.Image(
                    icon_name="dialog-warning-symbolic",
                    tooltip_text=_(
                        "AllowedIPs catches all traffic but no DNS is set"
                        " — possible DNS leak"),
                    valign=Gtk.Align.CENTER,
                )
                warn.add_css_class("warning")
                row.add_prefix(warn)

            edit_btn = Gtk.Button(icon_name="document-edit-symbolic",
                                  valign=Gtk.Align.CENTER,
                                  tooltip_text=_("Edit config"))
            edit_btn.add_css_class("flat")
            edit_btn.connect("clicked", self._edit_tunnel, name)

            del_btn = Gtk.Button(icon_name="user-trash-symbolic",
                                 valign=Gtk.Align.CENTER,
                                 tooltip_text=_("Delete tunnel"))
            del_btn.add_css_class("flat")
            del_btn.connect("clicked", self._delete_tunnel, name)

            active = nm.get(name, False)
            toggle = Gtk.Button(
                label=_("Stop") if active else _("Start"),
                valign=Gtk.Align.CENTER,
                width_request=72,
            )
            if active:
                toggle.add_css_class("destructive-action")
            else:
                toggle.add_css_class("suggested-action")
            toggle.connect("clicked", self._on_toggle, name)

            row.add_suffix(edit_btn)
            row.add_suffix(del_btn)
            row.add_suffix(toggle)
            self.listbox.append(row)
            self.rows[name] = (row, toggle)

        self._update_rows(nm)

    def _render_row(self, name, row, toggle, active, fresh_ip=False):
        """Update one row. Only touches widgets whose value changed,
        so an idle window does not trigger redraws."""
        want_label = _("Stop") if active else _("Start")
        if toggle.get_label() != want_label:
            toggle.set_label(want_label)
            toggle.remove_css_class("suggested-action")
            toggle.remove_css_class("destructive-action")
            toggle.add_css_class(
                "destructive-action" if active else "suggested-action")

        iface = self.ifaces.get(name, name)
        if active:
            ip = None if fresh_ip else _details_cache.get(name)
            if ip is None:
                ip = iface_ipv4(iface)
                _details_cache[name] = ip
            parts = [ip] if ip else []
            t = iface_traffic(iface)
            if t:
                parts.append(f"↓ {human_bytes(t[0])}  ↑ {human_bytes(t[1])}")
            subtitle = _("Active")
            if parts:
                subtitle += " — " + "  ·  ".join(parts)
        else:
            _details_cache.pop(name, None)
            if name in self.nm_names or os.path.exists(conf_path(name)):
                subtitle = _("Inactive")
            else:
                subtitle = _("Missing config")

        if row.get_subtitle() != subtitle:
            row.set_subtitle(subtitle)

    def _update_rows(self, nm=None):
        """Full refresh — asks NetworkManager. Only after user actions."""
        if nm is None:
            nm = nm_wireguard_connections()
        self.nm_names = set(nm)
        for name, (row, toggle) in self.rows.items():
            self._render_row(name, row, toggle, nm.get(name, False),
                             fresh_ip=True)
        return False   # also used with GLib.idle_add: run once

    def _on_close(self, _win):
        # stop the refresh timer and quit the application cleanly
        if getattr(self, "_timer_id", None):
            GLib.source_remove(self._timer_id)
            self._timer_id = None
        app = self.get_application()
        if app is not None:
            app.quit()
        return False

    def _tick(self):
        """Periodic refresh — reads the kernel only, never NetworkManager."""
        if getattr(self, "_timer_id", None) is None:
            return False
        for name, (row, toggle) in self.rows.items():
            active = iface_is_up(self.ifaces.get(name, name))
            self._render_row(name, row, toggle, active)
        return True

    def toast(self, msg):
        self.toast_overlay.add_toast(Adw.Toast(title=msg, timeout=4))

    def _on_toggle(self, btn, name):
        btn.set_sensitive(False)

        def done(msg=None):
            # runs once on the GTK thread; returns False so it is not repeated
            if msg:
                self.toast(msg)
            btn.set_sensitive(True)
            self._update_rows()
            return False

        def do_it():
            # all nmcli calls happen here, off the GTK thread
            nm = nm_wireguard_connections()
            want_up = not nm.get(name, False)
            if want_up:
                if name not in nm:
                    ok, out = nm_import(name)
                    if not ok:
                        GLib.idle_add(done, _("Import failed: {err}").format(
                            err=out.splitlines()[-1] if out else "nmcli"))
                        return
                # tunnels are manual-only: never auto-activate on boot/login
                nmcli("connection", "modify", name,
                      "connection.autoconnect", "no")
                ok, out = nmcli("connection", "up", name)
            else:
                nmcli("connection", "modify", name,
                      "connection.autoconnect", "no")
                ok, out = nmcli("connection", "down", name)
            msg = None
            if not ok:
                msg = out.splitlines()[-1] if out else "nmcli failed"
            GLib.idle_add(done, msg)

        threading.Thread(target=do_it, daemon=True).start()

    def _reimport(self, name):
        """After save/import: replace the NM profile with the file."""
        nm = nm_wireguard_connections()
        was_active = nm.get(name, False)
        if name in nm:
            nmcli("connection", "delete", name)
        ok, out = nm_import(name, keep_up=was_active)
        self.rebuild()
        if ok:
            self.toast(_("Saved {name}.conf").format(name=name))
        else:
            self.toast(_("Import failed: {err}").format(
                err=out.splitlines()[-1] if out else "nmcli"))

    def _edit_tunnel(self, _btn, name):
        if not os.path.exists(conf_path(name)):
            self.toast(_("No local config — opening template in editor"))
        EditorWindow(self, name, self._reimport).present()

    def _delete_tunnel(self, _btn, name):
        d = Adw.AlertDialog(
            heading=_("Delete {name}?").format(name=name),
            body=_("Removes the tunnel from NetworkManager and "
                   "deletes the local config file."),
        )
        d.add_response("cancel", _("Cancel"))
        d.add_response("delete", _("Delete"))
        d.set_response_appearance("delete", Adw.ResponseAppearance.DESTRUCTIVE)

        def on_response(_d, response):
            if response != "delete":
                return
            nmcli("connection", "down", name)
            nmcli("connection", "delete", name)
            try:
                os.remove(conf_path(name))
            except FileNotFoundError:
                pass
            self.rebuild()

        d.connect("response", on_response)
        d.present(self)

    def new_tunnel(self, _btn):
        d = Adw.AlertDialog(heading=_("New tunnel"),
                            body=_("Interface name (max 15 characters)"))
        entry = Gtk.Entry(placeholder_text="wg0", activates_default=True)
        d.set_extra_child(entry)
        d.add_response("cancel", _("Cancel"))
        d.add_response("create", _("Create"))
        d.set_response_appearance("create", Adw.ResponseAppearance.SUGGESTED)
        d.set_default_response("create")

        def on_response(_d, response):
            if response != "create":
                return
            name = entry.get_text().strip()
            if not valid_name(name):
                self.toast(
                    _("Invalid name — letters/digits/_=+.- max 15 chars"))
                return
            if os.path.exists(conf_path(name)):
                self.toast(_("{name} already exists").format(name=name))
                return
            EditorWindow(self, name, self._reimport).present()

        d.connect("response", on_response)
        d.present(self)

    def import_conf(self, _btn):
        dlg = Gtk.FileDialog(title=_("Import WireGuard config"))
        ff  = Gtk.FileFilter()
        ff.set_name("WireGuard config (*.conf)")
        ff.add_pattern("*.conf")
        store = Gio.ListStore.new(Gtk.FileFilter)
        store.append(ff)
        dlg.set_filters(store)

        def on_open(d, result):
            try:
                gfile = d.open_finish(result)
            except GLib.Error:
                return
            self._install_conf(gfile.get_path())

        dlg.open(self, None, on_open)

    def _install_conf(self, src):
        base = os.path.basename(src)
        name = base[:-5] if base.endswith(".conf") else base
        if not valid_name(name):
            self.toast(
                _("Filename must be a valid interface name (max 15 chars)"))
            return False
        try:
            text = _read(src)
            ensure_conf_dir()
            write_private(conf_path(name), text)
        except (OSError, UnicodeDecodeError) as exc:
            self.toast(str(exc))
            return False
        self._reimport(name)
        return True

    def import_zip(self, _btn):
        dlg = Gtk.FileDialog(title=_("Import WireGuard .zip bundle"))
        ff  = Gtk.FileFilter()
        ff.set_name("ZIP bundle (*.zip)")
        ff.add_pattern("*.zip")
        store = Gio.ListStore.new(Gtk.FileFilter)
        store.append(ff)
        dlg.set_filters(store)

        def on_open(d, result):
            try:
                gfile = d.open_finish(result)
            except GLib.Error:
                return
            self._import_zip_file(gfile.get_path())

        dlg.open(self, None, on_open)

    def _import_zip_file(self, path):
        imported, skipped = [], []
        try:
            with zipfile.ZipFile(path) as zf:
                for entry in zf.namelist():
                    if not entry.endswith(".conf"):
                        continue
                    base = os.path.basename(entry)
                    name = base[:-5]
                    if not valid_name(name):
                        skipped.append(base)
                        continue
                    try:
                        text = zf.read(entry).decode("utf-8")
                    except (UnicodeDecodeError, KeyError):
                        skipped.append(base)
                        continue
                    ensure_conf_dir()
                    write_private(conf_path(name), text)
                    nmcli("connection", "delete", name)
                    # do not assign to "_": that is the translation function
                    ok, _out = nm_import(name)
                    (imported if ok else skipped).append(name)
        except zipfile.BadZipFile:
            self.toast(_("Not a valid ZIP file"))
            return

        self.rebuild()
        parts = []
        if imported:
            parts.append(_("{n} imported").format(n=len(imported)))
        if skipped:
            parts.append(_("{n} skipped").format(n=len(skipped)))
        self.toast(", ".join(parts) or _("Nothing imported"))


# ---------------------------------------------------------------- application

class App(Adw.Application):
    def __init__(self):
        super().__init__(application_id=APP_ID,
                         flags=Gio.ApplicationFlags.DEFAULT_FLAGS)

    def do_activate(self):
        win = self.get_active_window() or MainWindow(self)
        win.present()


if __name__ == "__main__":
    # Adw.AlertDialog needs libadwaita 1.5, Gtk.FileDialog needs GTK 4.10
    if (Adw.get_major_version(), Adw.get_minor_version()) < (1, 5) or \
            (Gtk.get_major_version(), Gtk.get_minor_version()) < (4, 10):
        sys.exit("Wirefox needs GTK 4.10 and libadwaita 1.5 or newer "
                 "(Ubuntu 24.04+, Debian 13+, Fedora 40+). Found GTK "
                 f"{Gtk.get_major_version()}.{Gtk.get_minor_version()}, "
                 f"libadwaita {Adw.get_major_version()}.{Adw.get_minor_version()}.")
    if shutil.which("nmcli") is None:
        sys.exit("NetworkManager (nmcli) is required.\n"
                 "  Debian/Ubuntu: sudo apt install network-manager\n"
                 "  Fedora:        sudo dnf install NetworkManager")
    # Gtk.init_check() can report success without a display; ask Gdk instead
    if Gdk.Display.get_default() is None:
        sys.exit("Wirefox needs a graphical session (no display found).")
    sys.exit(App().run(sys.argv))
