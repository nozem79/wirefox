#: wirefox:323
#, python-brace-format
msgid ""
"Import a .conf file or create a new tunnel.\n"
"Configs live in {CONF_DIR}"
msgstr ""
"Importeer een .conf-bestand of maak een nieuwe tunnel.\n"
"Configs staan in {CONF_DIR}"

#: wirefox:366
msgid "AllowedIPs catches all traffic but no DNS is set — possible DNS leak"
msgstr ""
"AllowedIPs vangt al het verkeer maar er is geen DNS ingesteld — mogelijke "
"DNS-lek"

#: wirefox:375
msgid "Edit config"
msgstr "Configuratie bewerken"

#: wirefox:381
msgid "Delete tunnel"
msgstr "Tunnel verwijderen"

#: wirefox:387 wirefox:408
msgid "Stop"
msgstr "Stop"

#: wirefox:387 wirefox:408
msgid "Start"
msgstr "Start"

#: wirefox:426
msgid "Active"
msgstr "Actief"

#: wirefox:432
msgid "Inactive"
msgstr "Inactief"

#: wirefox:434
msgid "Missing config"
msgstr "Configuratie ontbreekt"

