#, python-brace-format
msgid "Import failed: {err}"
msgstr "Importeren mislukt: {err}"

#: wirefox:517
#, python-brace-format
msgid "Saved {name}.conf"
msgstr "{name}.conf opgeslagen"

#: wirefox:524
msgid "No local config — opening template in editor"
